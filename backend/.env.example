# Copy this file to .env and supply a server-side Gemini API key.
GEMINI_API_KEY=
# Current stable multimodal model, configurable per environment.
GEMINI_VISION_MODEL=gemini-3.6-flash
# Comma-separated origins allowed to call this API during local development.
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
